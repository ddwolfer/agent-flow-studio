{
  "$schema_version": 1,
  "name": "crypto-daily",
  "description": "Daily crypto + crypto-adjacent macro briefing",
  "model": "claude-sonnet-4-6",
  "max_turns": 90,
  "sources": [
    { "kind": "extras_json", "name": "fetch_btc_cycle (幣本位資金費率 / KDJ 4h-1d-1w / 200D MA / 難度+礦工投降訊號 / 算力)" },
    { "kind": "youtube", "name": "加密龐克", "handle": "@crypto_punks", "search_query": "crypto_punks" },
    { "kind": "youtube", "name": "BTV", "handle": "@BTV_CN", "search_query": "BTV_CN" },
    { "kind": "youtube", "name": "Altcoin Daily", "handle": "@AltcoinDaily", "search_query": "Altcoin Daily" },
    { "kind": "youtube", "name": "Coin Bureau", "handle": "@CoinBureau", "search_query": "Coin Bureau" },
    { "kind": "youtube", "name": "Benjamin Cowen (Into The Cryptoverse)", "handle": "UCRvqjQPSeaWn-uEx-w0XOIg", "search_query": "Benjamin Cowen Into The Cryptoverse" },
    { "kind": "youtube", "name": "提阿非羅大人TiaBTC", "handle": "@tiabtc", "search_query": "tiabtc" },
    { "kind": "web", "name": "zombit", "url": "https://zombit.info/", "rss": "https://zombit.info/feed/" }
  ],
  "tools": ["yt-dlp", "rss", "web-fetch"],
  "prompts": [
    "prompts/shared/faithfulness.md",
    "prompts/crypto/framework.md",
    "prompts/crypto/voice.md",
    "prompts/crypto/main.md"
  ],
  "output": "reports/crypto-daily/{date}.html",
  "post": { "pdf": true, "telegram": "TELEGRAM_TOPIC_CRYPTO" },
  "history": {
    "format": "jsonl",
    "summarize_with": "claude-haiku-4-5",
    "fields": ["overall_stance", "confidence", "top_signals", "top_risks"]
  }
}
