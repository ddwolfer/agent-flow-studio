# Financial Report System — cron schedule (Taiwan time, UTC+8)
# Edit with: crontab -e

# 個股新聞日報（持倉 + 觀察名單）— 每天 8:00am
0 8 * * * /path/to/financial-report-system/scripts/stock-news-daily.sh

# 每日總經 × 台股戰情室 briefing — 平日 9:30am（盤前）
30 9 * * 1-5 /path/to/financial-report-system/scripts/daily-briefing.sh

# Eason 視角晚間報告 — 平日 8:00pm
0 20 * * 1-5 /path/to/financial-report-system/scripts/eason-daily.sh

# Personal watchlist scan (no notifications, internal use only)
# 0 7 * * 1-5 /path/to/financial-report-system/scripts/stock-daily-news.sh
