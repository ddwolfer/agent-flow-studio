# Copy this to .env in the same directory and fill in real values.
# Source: scripts/notify.sh expects these to be exported before running.

# === Discord ===
# Main briefing/Eason channel (used by notify.sh send_discord)
DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYYY

# Separate channel for stock-news-daily.sh (different from main webhook)
STOCK_NEWS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/AAAAAAA/BBBBBBB

# === LINE Messaging API ===
# Channel access token from https://developers.line.biz console
LINE_TOKEN=your_line_channel_access_token_here

# Target group ID (or user ID) — get via webhook event payload
LINE_GROUP_ID=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === freeimage.host (free image upload) ===
# Sign up at https://freeimage.host/page/api to get a key
IMGHOST_KEY=your_freeimage_host_api_key
