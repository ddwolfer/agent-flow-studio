# === Telegram (copy the two shared values from finance-workflows/.env) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ARB=1390

# === Exchange READ-ONLY keys (M4 — leave blank until then) ===
# NEVER enable trade/withdraw/transfer on these keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# === Announcement LLM (only used when announcement_llm: true in config.yaml) ===
# Groq is OpenAI-compatible, supports JSON mode, generous free tier.
GROQ_API_KEY=
# Optional override — only set if you want a non-default Groq model
# (e.g. when llama-3.3-70b-versatile gets decommissioned).
# GROQ_MODEL=
